# ==============================================================================
# Contract Management System - Docker Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Update MSSQL_SA_PASSWORD with your desired secure password.
# ==============================================================================

# SQL Server Configuration
# Note: Password must be at least 8 characters and contain at least 3 of:
# uppercase, lowercase, numbers, and symbols.
MSSQL_SA_PASSWORD=YourStrong@Passw0rd_ChangeMe123!
MSSQL_PORT=1433

# ASP.NET Core Backend Configuration
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5028

# Frontend Web Configuration
FRONTEND_PORT=5173
